<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:background="#F7F7F8">
    <TextView android:id="@+id/btnBack" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="← Retour" android:textSize="16sp" android:padding="8dp"/>
    <TextView android:text="GAME TURBO" android:textSize="28sp" android:textStyle="bold" android:layout_marginTop="16dp"/>
    <TextView android:text="Choisis ton mode" android:textColor="#64748B" android:layout_marginTop="4dp"/>
    <androidx.cardview.widget.CardView android:id="@+id/cardBalanced" android:layout_width="match_parent" android:layout_height="90dp" android:layout_marginTop="24dp" app:cardCornerRadius="20dp" app:cardElevation="0dp"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="#E0F2FE"><TextView android:text="Balanced" android:textStyle="bold"/><TextView android:text="60Hz / économie batterie" android:textSize="12sp" android:textColor="#0284C7"/></LinearLayout></androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView android:id="@+id/cardPerf" android:layout_width="match_parent" android:layout_height="90dp" android:layout_marginTop="12dp" app:cardCornerRadius="20dp" app:cardElevation="0dp"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="#EDE9FE"><TextView android:text="Performance" android:textStyle="bold"/><TextView android:text="90Hz / boost internet" android:textSize="12sp" android:textColor="#7C3AED"/></LinearLayout></androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView android:id="@+id/cardBeast" android:layout_width="match_parent" android:layout_height="90dp" android:layout_marginTop="12dp" app:cardCornerRadius="20dp" app:cardElevation="0dp"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="#FEF3C7"><TextView android:text="BEAST MODE" android:textStyle="bold"/><TextView android:text="Max CPU/GPU / Ping 0" android:textSize="12sp" android:textColor="#D97706"/></LinearLayout></androidx.cardview.widget.CardView>
</LinearLayout>

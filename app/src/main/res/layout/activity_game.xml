<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp" android:background="#F7F7F8">
    <TextView android:id="@+id/btnBack" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="← Retour" android:textSize="16sp" android:padding="8dp"/>
    <TextView android:text="GAME TURBO" android:textSize="28sp" android:textStyle="bold" android:layout_marginTop="16dp"/>
    <LinearLayout android:id="@+id/cardBalanced" android:layout_width="match_parent" android:layout_height="90dp" android:layout_marginTop="24dp" android:background="@drawable/bg_btn_blue" android:orientation="vertical" android:padding="16dp"><TextView android:text="Balanced" android:textStyle="bold"/><TextView android:text="60Hz / économie" android:textSize="12sp"/></LinearLayout>
    <LinearLayout android:id="@+id/cardPerf" android:layout_width="match_parent" android:layout_height="90dp" android:layout_marginTop="12dp" android:background="@drawable/bg_btn_purple" android:orientation="vertical" android:padding="16dp"><TextView android:text="Performance" android:textStyle="bold"/><TextView android:text="90Hz / boost" android:textSize="12sp"/></LinearLayout>
    <LinearLayout android:id="@+id/cardBeast" android:layout_width="match_parent" android:layout_height="90dp" android:layout_marginTop="12dp" android:background="@drawable/bg_btn_yellow" android:orientation="vertical" android:padding="16dp"><TextView android:text="BEAST MODE" android:textStyle="bold"/><TextView android:text="Max CPU/GPU" android:textSize="12sp"/></LinearLayout>
</LinearLayout>

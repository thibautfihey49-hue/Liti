<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F8"
    android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/timeView" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="17:07" android:textSize="32sp" android:textStyle="bold" android:textColor="#0F172A"/>
        <TextView android:id="@+id/ramPill" android:layout_width="wrap_content" android:layout_height="32dp" android:background="@drawable/pill_blue" android:text="RAM OK" android:paddingLeft="12dp" android:paddingRight="12dp" android:gravity="center" android:textColor="#ffffff" android:textSize="12sp" android:layout_marginEnd="8dp"/>
        <TextView android:id="@+id/batPill" android:layout_width="wrap_content" android:layout_height="32dp" android:background="@drawable/pill_green" android:text="78%" android:paddingLeft="12dp" android:paddingRight="12dp" android:gravity="center" android:textColor="#ffffff" android:textSize="12sp"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/coreCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="20dp">
        <TextView android:text="HYPER CORE" android:textSize="11sp" android:textColor="#64748B"/>
        <TextView android:id="@+id/ramText" android:text="1.2 GB libre" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="8dp"/>
        <ProgressBar android:id="@+id/ramProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="12dp" android:progress="70" android:max="100"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
        <LinearLayout android:id="@+id/btnClean" android:layout_width="0dp" android:layout_height="110dp" android:layout_weight="1" android:layout_margin="6dp" android:background="@drawable/bg_btn_blue" android:orientation="vertical" android:padding="16dp"><TextView android:text="🧹" android:textSize="24sp"/><TextView android:text="CLEAN RAM" android:textStyle="bold" android:layout_marginTop="8dp"/><TextView android:text="+850 MB" android:textSize="12sp"/></LinearLayout>
        <LinearLayout android:id="@+id/btnNet" android:layout_width="0dp" android:layout_height="110dp" android:layout_weight="1" android:layout_margin="6dp" android:background="@drawable/bg_btn_purple" android:orientation="vertical" android:padding="16dp"><TextView android:text="⚡" android:textSize="24sp"/><TextView android:text="BOOST NET" android:textStyle="bold" android:layout_marginTop="8dp"/><TextView android:id="@+id/pingText" android:text="Ping 14ms" android:textSize="12sp"/></LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <LinearLayout android:id="@+id/btnGame" android:layout_width="0dp" android:layout_height="110dp" android:layout_weight="1" android:layout_margin="6dp" android:background="@drawable/bg_btn_yellow" android:orientation="vertical" android:padding="16dp"><TextView android:text="🎮" android:textSize="24sp"/><TextView android:text="GAME TURBO" android:textStyle="bold" android:layout_marginTop="8dp"/><TextView android:text="Beast Mode" android:textSize="12sp"/></LinearLayout>
        <LinearLayout android:id="@+id/btnSleep" android:layout_width="0dp" android:layout_height="110dp" android:layout_weight="1" android:layout_margin="6dp" android:background="@drawable/bg_btn_green" android:orientation="vertical" android:padding="16dp"><TextView android:text="🌙" android:textSize="24sp"/><TextView android:text="DEEP SLEEP" android:textStyle="bold" android:layout_marginTop="8dp"/><TextView android:text="+3.2h" android:textSize="12sp"/></LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/appList" android:layout_width="match_parent" android:layout_height="500dp" android:layout_marginTop="16dp"/>

</LinearLayout>
</ScrollView>
